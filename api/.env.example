# ---------------------------------------------------------------------------
# Environment template for the API.
# Copy to `.env.development.local` (loaded by dotenv-rails) and fill in.
# Every external risk provider is OPTIONAL: without a key the corresponding
# adapter reports itself as "not configured" and the manual / open-data path is
# used instead (see docs/07-risk-data-providers.md).
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
RAILS_ENV=development
RAILS_LOG_LEVEL=debug
PORT=3000
# Comma separated list of allowed SPA origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Background jobs --------------------------------------------------------
# solid_queue (Linux/macOS default) | async (Windows default) | inline (tests)
# BACKGROUND_JOB_ADAPTER=async
# QUEUE_THREADS=5
# JOB_CONCURRENCY=1

# --- Secrets ----------------------------------------------------------------
# REQUIRED IN PRODUCTION
# SECRET_KEY_BASE=
# AR_ENCRYPTION_PRIMARY_KEY=
# AR_ENCRYPTION_DETERMINISTIC_KEY=
# AR_ENCRYPTION_KEY_DERIVATION_SALT=
# JWT_SECRET=

# ===========================================================================
# FREE / OPEN DATA PROVIDERS (no registration or a free API key)
# ===========================================================================
# World Bank Logistics Performance Index - no key required
# GDACS disaster alerts - no key required
# USGS earthquakes - no key required
# Open-Meteo weather - no key required
# ECB / Frankfurter FX rates - no key required
# EU sanctions map / TARIC - no key required
# OpenSky / DCSA port data - optional key:
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
# Freightos Baltic Index (free tier key):
# FREIGHTOS_API_KEY=
# FRED (St. Louis Fed) - free key, freight & price indices:
# FRED_API_KEY=
# OpenWeatherMap - free tier key, more precise severe weather alerts:
# OPENWEATHER_API_KEY=

# ===========================================================================
# PAID SCRM / VISIBILITY PROVIDERS (all optional)
# Every key is stored encrypted at rest (ActiveRecord::Encryption) once entered
# through POST /api/v1/risk_providers/:key/configure - you normally do NOT keep
# them in this file.
# ===========================================================================
# --- Supply chain visibility / real-time transportation ----------------------
# PROJECT44_API_KEY=
# PROJECT44_API_SECRET=
# FOURKITES_API_KEY=
# MAERSK_API_KEY=
# FLEXPORT_API_KEY=
# SHIPPEO_API_KEY=
# OCEAN_INSIGHTS_API_KEY=
# VIZION_API_KEY=
# --- Risk intelligence platforms --------------------------------------------
# EVERSTREAM_API_KEY=
# RESILINC_API_KEY=
# RISK_METHODS_API_KEY=
# INTEROS_API_KEY=
# PREWAVE_API_KEY=
# SPARETECH_API_KEY=
# --- Financial / firmographic ------------------------------------------------
# DUN_BRADSTREET_API_KEY=
# MOODY_API_KEY=
# RAPID_RATINGS_API_KEY=
# CRAFT_API_KEY=
# --- Customs / trade compliance ---------------------------------------------
# DESCARTES_API_KEY=
# AMBER_ROAD_API_KEY=
# THOMSON_REUTERS_ONECLEAR_API_KEY=

# --- Outbound HTTP tuning ---------------------------------------------------
# RATE_LIMIT_RESPECT_RETRY_AFTER=true
# HTTP_OPEN_TIMEOUT=5
# HTTP_READ_TIMEOUT=15
# HTTP_MAX_RETRIES=3