# ---------------------------------------------------------------------------
# Environment template for the API.
# Copy to `.env.development.local` (loaded by dotenv-rails) and fill in.
# Every external risk provider is OPTIONAL: without a key the corresponding
# adapter reports itself as "not configured" and the manual / open-data path is
# used instead (see docs/07-risk-data-providers.md).
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
RAILS_ENV=development
RAILS_LOG_LEVEL=debug
PORT=3000
# Comma separated list of allowed SPA origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Background jobs --------------------------------------------------------
# solid_queue (Linux/macOS default) | async (Windows default) | inline (tests)
# BACKGROUND_JOB_ADAPTER=async
# QUEUE_THREADS=5
# JOB_CONCURRENCY=1

# --- Secrets ----------------------------------------------------------------
# REQUIRED IN PRODUCTION
# SECRET_KEY_BASE=
# AR_ENCRYPTION_PRIMARY_KEY=
# AR_ENCRYPTION_DETERMINISTIC_KEY=
# AR_ENCRYPTION_KEY_DERIVATION_SALT=
# JWT_SECRET=

# ===========================================================================
# FREE / OPEN DATA PROVIDERS (no registration or a free API key)
# ===========================================================================
# World Bank Logistics Performance Index - no key required
# GDACS disaster alerts - no key required
# USGS earthquakes - no key required
# Open-Meteo weather - no key required
# ECB / Frankfurter FX rates - no key required
# UN Comtrade - no key required (public preview)
# EU sanctions / OFAC SDN lists - no key required (CSV download)

# ReliefWeb (UN OCHA) - optional "appname" so the API allows higher limits.
#   A free appname is requested at https://apidoc.reliefweb.int/#appname
# RELIEFWEB_APPNAME=god-engine-risk-intelligence

# EU TARIC / Access2Markets - no free REST endpoint; point it at the JSON
#   interface your organisation is entitled to use (or an internal cache).
# EU_TARIC_BASE_URL=https://example.com/taric
# EU_TARIC_MEASURES_PATH=/api/measures

# Freightos Baltic Index (FBX) - free tier key + optional endpoint override:
# FREIGHTOS_API_KEY=
# FREIGHTOS_BASE_URL=https://api.freightos.com
# FREIGHTOS_INDEX_PATH=/v1/index/fbx

# FRED (St. Louis Fed) - free key, freight & price indices:
# FRED_API_KEY=

# OpenWeatherMap - free tier key, more precise severe weather alerts:
# OPENWEATHER_API_KEY=

# ===========================================================================
# RISK NOTIFICATION TUNING
# ===========================================================================
# Minimum event severity that triggers an in-app notification
# (low | medium | high | critical). Defaults to "low" (= everything).
# RISK_NOTIFICATION_MIN_SEVERITY=low

# ===========================================================================
# PAID SCRM / VISIBILITY PROVIDERS (all optional)
# ===========================================================================
# Every key is stored encrypted at rest (ActiveRecord::Encryption) once entered
# through POST /api/v1/risk_providers/:key/configure - you normally do NOT keep
# them in this file. They are listed here only as the *environment* fallback for
# single-tenant deployments.
# ---------------------------------------------------------------------------
# --- Supply chain visibility / real-time transportation ----------------------
# PROJECT44_API_KEY=
# PROJECT44_API_SECRET=
# FOURKITES_API_KEY=
# MAERSK_API_KEY=
# FLEXPORT_API_KEY=
# SHIPPEO_API_KEY=
# OCEAN_INSIGHTS_API_KEY=
# VIZION_API_KEY=
# --- Risk intelligence platforms --------------------------------------------
# EVERSTREAM_API_KEY=
# RESILINC_API_KEY=
# RISK_METHODS_API_KEY=
# INTEROS_API_KEY=
# PREWAVE_API_KEY=
# --- Financial / firmographic ------------------------------------------------
# DUN_BRADSTREET_API_KEY=
# MOODY_API_KEY=
# RAPID_RATINGS_API_KEY=
# --- Customs / trade compliance ---------------------------------------------
# DESCARTES_API_KEY=
# AMBER_ROAD_API_KEY=
# THOMSON_REUTERS_ONECLEAR_API_KEY=

# ===========================================================================
# PER-PROJECT PROVIDER CONFIGURATION (URLs + keys + endpoint overrides)
# ===========================================================================
# In addition to environment variables, every provider can be configured PER
# PROJECT through the API. This is the only place where a *different* endpoint
# per project (e.g. one tenant behind a broker, another on the vendor API)
# makes sense:
#
#   POST /api/v1/risk_providers/<key>/configure
#   {
#     "projectId": "<uuid>",
#     "enabled": true,
#     "pollIntervalMinutes": 30,
#     "apiKey": "<encrypted at rest, never returned>",
#     "config": {
#       "baseUrl": "https://...",
#       "assessmentPath": "/...",
#       "eventsPath": "/...",
#       "tokenUrl": "https://.../oauth2/token",
#       "appname": "my-reliefweb-app",
#       "mapping": { "riskScore": "/data/score", "riskLevel": "/data/level" }
#     }
#   }
#
# Precedence (highest first):
#   1. per-project `config` JSON + encrypted `api_key`  (risk_provider_configs)
#   2. environment variables                            (this file)
#   3. adapter / catalogue defaults                     (risk_providers.yml + provider class)
#
# Which keys each source understands:
#   eu_taric         baseUrl, assessmentPath, mapping (or EU_TARIC_* env vars)
#   reliefweb        appname                            (or RELIEFWEB_APPNAME)
#   freightos_fbx    baseUrl, assessmentPath            (or FREIGHTOS_* env vars)
#   fred_economic    apiKey                             (or FRED_API_KEY)
#   openweather_alerts apiKey                           (or OPENWEATHER_API_KEY)
#   paid adapters    baseUrl, assessmentPath, eventsPath, tokenUrl, mapping, apiKey(+secret via env)

# --- Outbound HTTP tuning ---------------------------------------------------
# RATE_LIMIT_RESPECT_RETRY_AFTER=true
# HTTP_OPEN_TIMEOUT=5
# HTTP_READ_TIMEOUT=15
# HTTP_MAX_RETRIES=3
